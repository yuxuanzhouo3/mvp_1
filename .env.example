# =====================================================
# PersonaLink 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# =====================================================

# =====================================================
# Supabase 配置
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================
# Firebase 推送通知配置 (INTL 环境)
# 从 Firebase Console > 项目设置 > 常规 获取
# =====================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890123
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890123:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase VAPID Key (用于 Web Push)
# 从 Firebase Console > 项目设置 > Cloud Messaging > Web Push 证书 获取
NEXT_PUBLIC_FIREBASE_VAPID_KEY=YOUR_VAPID_KEY_HERE

# Firebase Admin SDK (服务端推送)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY=your-private-key

# =====================================================
# Stripe 支付配置
# =====================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
# 生产环境（Live模式）
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# 测试环境（Sanbox模式）
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_xxxx

# =====================================================
# PayPal 支付配置 (国际版)
# 从 PayPal Developer Dashboard 获取
# https://developer.paypal.com/dashboard/applications
# =====================================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# =====================================================
# 应用配置
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PersonaLink
NEXT_PUBLIC_ENVIRONMENT=development

# =====================================================
# 开发调试配置
# =====================================================
NEXT_PUBLIC_MOCK_MODE=false
LOG_LEVEL=info