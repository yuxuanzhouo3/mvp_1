# =====================================================
# PersonaLink 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# =====================================================

# =====================================================
# Supabase 配置
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Native Sign-In (INTL Android app container)
# Use the OAuth 2.0 Web Client ID from the same Google Cloud project as your Android OAuth client.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional switch: set to false/0/off/no to disable native Google sign-in in app container.
NEXT_PUBLIC_ENABLE_NATIVE_GOOGLE_SIGN_IN=true

# =====================================================
# Firebase 推送通知配置 (INTL 环境)
# 从 Firebase Console > 项目设置 > 常规 获取
# =====================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890123
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890123:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase VAPID Key (用于 Web Push)
# 从 Firebase Console > 项目设置 > Cloud Messaging > Web Push 证书 获取
NEXT_PUBLIC_FIREBASE_VAPID_KEY=YOUR_VAPID_KEY_HERE

# Firebase Admin SDK (服务端推送)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY=your-private-key

# =====================================================
# Stripe 支付配置
# =====================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
# 生产环境（Live模式）
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# 测试环境（Sanbox模式）
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_xxxx

# =====================================================
# PayPal 支付配置 (国际版)
# 从 PayPal Developer Dashboard 获取
# https://developer.paypal.com/dashboard/applications
# =====================================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# =====================================================
# 应用配置
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PersonaLink
NEXT_PUBLIC_ENVIRONMENT=development

# =====================================================
# 开发调试配置
# =====================================================
NEXT_PUBLIC_MOCK_MODE=false
LOG_LEVEL=info
PAYMENT_TEST_MODE=false
# Call debug panel switch for CN chat page (true/false)
NEXT_PUBLIC_ENABLE_CALL_DEBUG=false

# 默认月度预算(tokens)
AI_MONTHLY_TOKEN_BUDGET=your_monthly_budget_in_usd
# AI配置
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE

# =====================================================
# 部署环境配置
# CN: 中国版 | INTL: 国际版
# =====================================================
NEXT_PUBLIC_DEPLOYMENT_REGION=INTL

# =====================================================
# Admin 后台（自定义认证 + 跨环境代理）
# =====================================================
# 管理员登录态签名密钥（生产环境必须设置）
ADMIN_SESSION_SECRET=your-admin-session-secret

# CN/INTL 站点域名（用于跨环境代理转发）
CN_APP_ORIGIN=https://personalink.mornscience.top
INTL_APP_ORIGIN=https://www.mornhub.lat

# 统计接口跨环境代理密钥（两套站点需设置为相同值，server-to-server 使用）
AI_STATS_PROXY_SECRET=your-shared-ai-stats-proxy-secret
# 可选：Credits stats 单独指定代理密钥（不设置则回退使用 AI_STATS_PROXY_SECRET）
CREDITS_STATS_PROXY_SECRET=your-shared-credits-proxy-secret

# =====================================================
# 环信 IM 配置 (CN 环境)
# 从环信管理后台获取: https://console.easemob.com
# =====================================================
NEXT_PUBLIC_EASEMOB_APP_KEY=your-org-name#your-app-name
EASEMOB_API_BASE=https://a1.easemob.com
EASEMOB_ORG_NAME=your-org-name
EASEMOB_APP_NAME=your-app-name
EASEMOB_CLIENT_ID=your-client-id
EASEMOB_CLIENT_SECRET=your-client-secret

# =====================================================
# 腾讯云 Cloudbase 配置 (CN 环境)
# 从腾讯云控制台获取: https://console.cloud.tencent.com/tcb
# =====================================================
NEXT_PUBLIC_CLOUDBASE_ENV_ID=your-cloudbase-env-id
CLOUDBASE_SECRET_ID=your-secret-id
CLOUDBASE_SECRET_KEY=your-secret-key

# Tencent ASR realtime speech recognition (CN)
TENCENT_ASR_APP_ID=your-tencent-asr-app-id
TENCENT_ASR_SECRET_ID=your-tencent-asr-secret-id
TENCENT_ASR_SECRET_KEY=your-tencent-asr-secret-key
# Optional model: 16k_zh / 16k_en
TENCENT_ASR_ENGINE_MODEL=16k_zh
NEXT_PUBLIC_TENCENT_ASR_ENGINE_MODEL=16k_zh

# =====================================================
# 微信开放平台 (微信登录, CN 环境)
# =====================================================
NEXT_PUBLIC_WECHAT_APP_ID=your-wechat-open-app-id
WECHAT_APP_ID=your-wechat-open-app-id
WECHAT_APP_SECRET=your-wechat-open-app-secret
WECHAT_MOBILE_APP=your-wechat-mobile-app-id
WECHAT_MOBILE_APP_SECRET=your-wechat-mobile-app-secret
WECHAT_OAUTH_STATE_SECRET=your-wechat-oauth-state-secret
WECHAT_MINIPROGRAM_APP_ID=your-wechat-miniprogram-app-id
WECHAT_MINIPROGRAM_APP_SECRET=your-wechat-miniprogram-app-secret

# =====================================================
# 腾讯地图 API Key (CN 环境)
# =====================================================
TENCENT_MAP_KEY=your-tencent-map-key

# =====================================================
# CN 邮箱验证码登录/注册/找回密码（腾讯企业邮箱 SMTP）
# =====================================================
AUTH_EMAIL_SMTP_HOST=smtp.exmail.qq.com
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_USER=your_email@example.com
AUTH_EMAIL_SMTP_PASS=your_smtp_password
AUTH_EMAIL_FROM=your_email@example.com
AUTH_EMAIL_CODE_SECRET=replace_with_strong_random_secret
